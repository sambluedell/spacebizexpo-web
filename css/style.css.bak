/* ===== 2026深圳国际商业航天展览会 ===== */
:root {
  --primary: #0a1f4a;
  --primary-light: #132e6b;
  --accent: #c9a84c;
  --accent-light: #e8c95a;
  --text-dark: #1a1a2e;
  --text-light: #6b7280;
  --bg-light: #f8f9fc;
  --white: #ffffff;
  --gradient-hero: linear-gradient(135deg, #0a1f4a 0%, #132e6b 50%, #1a3a7a 100%);
  --shadow: 0 4px 20px rgba(10, 31, 74, 0.1);
  --shadow-hover: 0 8px 40px rgba(10, 31, 74, 0.2);
  --radius: 12px;
  --max-width: 1200px;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: var(--text-dark);
  line-height: 1.6;
  overflow-x: hidden;
}

a { text-decoration: none; color: inherit; }
ul { list-style: none; }
img { max-width: 100%; display: block; }

/* ===== Container ===== */
.container {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 20px;
}

/* ===== Top Bar ===== */
.top-bar {
  background: var(--primary);
  color: rgba(255,255,255,.7);
  font-size: 13px;
  padding: 6px 0;
  border-bottom: 3px solid var(--accent);
}
.top-bar .container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.top-bar a { color: rgba(255,255,255,.7); }
.top-bar a:hover { color: var(--accent); }
.top-bar-links { display: flex; gap: 20px; }

/* ===== Header ===== */
.header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: var(--white);
  box-shadow: 0 2px 10px rgba(0,0,0,.08);
}
.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 70px;
}
.logo {
  display: flex;
  align-items: center;
  gap: 10px;
}
.logo-icon {
  width: 48px;
  height: 48px;
  background: var(--gradient-hero);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  font-size: 22px;
  font-weight: 900;
  flex-shrink: 0;
}
.logo-text h1 {
  font-size: 18px;
  color: var(--primary);
  line-height: 1.2;
}
.logo-text span {
  font-size: 12px;
  color: var(--text-light);
}

/* Navigation */
.nav { display: flex; align-items: center; gap: 4px; }
.nav > li { position: relative; }
.nav > li > a {
  display: block;
  padding: 10px 18px;
  font-size: 14px;
  color: var(--text-dark);
  border-radius: 6px;
  transition: all .3s;
  font-weight: 500;
}
.nav > li > a:hover,
.nav > li > a.active {
  color: var(--accent);
  background: rgba(201,168,76,.08);
}
.nav .dropdown { position: absolute; top: 100%; left: 0; min-width: 180px; background: var(--white);
  box-shadow: var(--shadow); border-radius: 8px; opacity: 0; visibility: hidden;
  transform: translateY(8px); transition: all .3s; z-index: 100; padding: 6px; }
.nav > li:hover .dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
.nav .dropdown a { display: block; padding: 8px 14px; font-size: 13px; color: var(--text-dark);
  border-radius: 4px; transition: all .2s; }
.nav .dropdown a:hover { background: rgba(201,168,76,.1); color: var(--accent); }

.nav .btn-register {
  background: linear-gradient(135deg, var(--accent), #d4a843);
  color: var(--primary) !important;
  padding: 10px 22px;
  font-weight: 700;
  border-radius: 6px;
}
.nav .btn-register:hover { background: linear-gradient(135deg, #d4a843, var(--accent-light)); }

.menu-toggle { display: none; background: none; border: none; font-size: 28px; cursor: pointer; color: var(--primary); }

/* ===== Hero ===== */
.hero {
  position: relative;
  min-height: 85vh;
  background: var(--gradient-hero);
  display: flex;
  align-items: center;
  overflow: hidden;
}
.hero-bg-shapes { position: absolute; inset: 0; overflow: hidden; }
.hero-bg-shapes::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -10%;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(201,168,76,.08) 0%, transparent 70%);
  border-radius: 50%;
}
.hero-bg-shapes::after {
  content: '';
  position: absolute;
  bottom: -20%;
  left: -5%;
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, rgba(255,255,255,.03) 0%, transparent 70%);
  border-radius: 50%;
}
.hero-stars {
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(2px 2px at 20px 30px, #eee, transparent),
    radial-gradient(2px 2px at 40px 70px, rgba(255,255,255,.8), transparent),
    radial-gradient(2px 2px at 50px 160px, #ddd, transparent),
    radial-gradient(2px 2px at 90px 40px, rgba(255,255,255,.6), transparent),
    radial-gradient(2px 2px at 130px 80px, #fff, transparent),
    radial-gradient(2px 2px at 160px 30px, rgba(255,255,255,.7), transparent);
  background-size: 200px 200px;
  opacity: .4;
}
.hero .container {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}
.hero-content { padding: 60px 0; }
.hero-badge {
  display: inline-block;
  background: rgba(201,168,76,.15);
  color: var(--accent);
  padding: 6px 18px;
  border-radius: 30px;
  font-size: 13px;
  font-weight: 600;
  border: 1px solid rgba(201,168,76,.3);
  margin-bottom: 20px;
}
.hero-content h2 {
  font-size: clamp(28px, 4vw, 48px);
  color: var(--white);
  line-height: 1.3;
  margin-bottom: 12px;
}
.hero-content h2 span { color: var(--accent); }
.hero-content .subtitle {
  font-size: clamp(16px, 2vw, 22px);
  color: rgba(255,255,255,.85);
  margin-bottom: 8px;
}
.hero-content .info {
  color: rgba(255,255,255,.65);
  font-size: 15px;
  margin-bottom: 30px;
  line-height: 1.8;
}
.hero-info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 30px;
}
.hero-info-item {
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 10px;
  padding: 16px;
  text-align: center;
}
.hero-info-item .icon { font-size: 24px; margin-bottom: 6px; }
.hero-info-item .label { font-size: 12px; color: rgba(255,255,255,.5); }
.hero-info-item .value { font-size: 14px; color: var(--accent); font-weight: 600; }
.hero-buttons { display: flex; gap: 12px; flex-wrap: wrap; }
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 32px;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: all .3s;
  border: none;
}
.btn-primary {
  background: linear-gradient(135deg, var(--accent), #d4a843);
  color: var(--primary);
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(201,168,76,.35); }
.btn-outline {
  background: transparent;
  color: var(--white);
  border: 2px solid rgba(255,255,255,.3);
}
.btn-outline:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }

/* Hero Right - Countdown Card */
.hero-card {
  background: rgba(255,255,255,.05);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 20px;
  padding: 40px;
  text-align: center;
}
.hero-card h3 { color: var(--white); font-size: 20px; margin-bottom: 24px; }
.countdown-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 24px; }
.countdown-item { background: rgba(255,255,255,.08); border-radius: 12px; padding: 16px 8px; }
.countdown-item .num {
  font-size: clamp(28px, 3.5vw, 42px);
  font-weight: 800;
  color: var(--accent);
  font-variant-numeric: tabular-nums;
}
.countdown-item .lbl { font-size: 12px; color: rgba(255,255,255,.5); margin-top: 4px; }
.hero-card .date-info { color: rgba(255,255,255,.7); font-size: 14px; }
.hero-card .date-info strong { color: var(--white); }

/* ===== Section Common ===== */
.section { padding: 80px 0; }
.section-alt { background: var(--bg-light); }
.section-title {
  text-align: center;
  margin-bottom: 50px;
}
.section-title h3 {
  font-size: clamp(24px, 3vw, 34px);
  color: var(--primary);
  margin-bottom: 8px;
  position: relative;
  display: inline-block;
}
.section-title h3::after {
  content: '';
  display: block;
  width: 60px;
  height: 3px;
  background: var(--accent);
  margin: 12px auto 0;
  border-radius: 2px;
}
.section-title p { color: var(--text-light); font-size: 15px; margin-top: 8px; }

/* ===== About Section ===== */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
  align-items: center;
}
.about-image {
  position: relative;
}
.about-image-placeholder {
  background: var(--gradient-hero);
  border-radius: 20px;
  padding: 50px;
  text-align: center;
  color: var(--white);
  min-height: 350px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.about-image-placeholder .big-icon { font-size: 72px; margin-bottom: 16px; }
.about-image-placeholder h4 { font-size: 20px; color: var(--accent); }
.about-image-placeholder p { font-size: 13px; opacity: .7; }
.about-content h4 { font-size: 22px; color: var(--primary); margin-bottom: 16px; }
.about-content p { color: var(--text-light); margin-bottom: 16px; font-size: 15px; line-height: 1.8; }
.org-list { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 20px; }
.org-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  background: var(--bg-light);
  border-radius: 8px;
  font-size: 13px;
  border-left: 3px solid var(--accent);
}
.org-item .role { color: var(--accent); font-weight: 700; font-size: 12px; min-width: 32px; }

/* ===== Stats ===== */
.stats {
  background: var(--gradient-hero);
  padding: 60px 0;
}
.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; }
.stats-item { text-align: center; color: var(--white); }
.stats-item .num { font-size: clamp(32px, 4vw, 48px); font-weight: 800; color: var(--accent); }
.stats-item .lbl { font-size: 14px; opacity: .7; margin-top: 6px; }

/* ===== Exhibition Scope ===== */
.scope-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
.scope-card {
  background: var(--white);
  border-radius: var(--radius);
  padding: 28px 24px;
  box-shadow: var(--shadow);
  transition: all .3s;
  border: 1px solid #f0f0f5;
  cursor: default;
}
.scope-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); }
.scope-card .icon { font-size: 32px; margin-bottom: 12px; }
.scope-card h4 { font-size: 16px; color: var(--primary); margin-bottom: 8px; }
.scope-card p { font-size: 13px; color: var(--text-light); line-height: 1.7; }

/* ===== Forum Topics ===== */
.forum-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 24px; }
.forum-card {
  background: var(--white);
  border-radius: var(--radius);
  padding: 30px;
  box-shadow: var(--shadow);
  border-left: 4px solid var(--accent);
  transition: all .3s;
}
.forum-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); }
.forum-card .num { font-size: 40px; font-weight: 900; color: rgba(201,168,76,.15); line-height: 1; }
.forum-card h4 { font-size: 16px; color: var(--primary); margin: 8px 0 10px; }
.forum-card p { font-size: 13px; color: var(--text-light); line-height: 1.7; }
.forum-card .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
.forum-card .tags span {
  background: rgba(201,168,76,.1);
  color: #8a7230;
  padding: 3px 10px;
  border-radius: 20px;
  font-size: 11px;
}

/* ===== Schedule ===== */
.schedule { position: relative; }
.schedule-tabs { display: flex; justify-content: center; gap: 12px; margin-bottom: 30px; }
.schedule-tab {
  padding: 10px 28px;
  border-radius: 30px;
  border: 1px solid #e0e0e5;
  background: var(--white);
  cursor: pointer;
  font-size: 14px;
  font-weight: 500;
  transition: all .3s;
}
.schedule-tab.active, .schedule-tab:hover { background: var(--primary); color: var(--white); border-color: var(--primary); }
.schedule-day { display: none; }
.schedule-day.active { display: block; }
.timeline { position: relative; padding-left: 30px; }
.timeline::before {
  content: '';
  position: absolute;
  left: 10px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: linear-gradient(to bottom, var(--accent), var(--primary));
}
.timeline-item {
  position: relative;
  padding: 16px 20px;
  margin-bottom: 16px;
  background: var(--white);
  border-radius: 10px;
  box-shadow: var(--shadow);
  border: 1px solid #f0f0f5;
}
.timeline-item::before {
  content: '';
  position: absolute;
  left: -26px;
  top: 22px;
  width: 12px;
  height: 12px;
  background: var(--accent);
  border-radius: 50%;
  border: 3px solid var(--white);
  box-shadow: var(--shadow);
}
.timeline-item .time {
  font-size: 13px;
  color: var(--accent);
  font-weight: 700;
  margin-bottom: 4px;
}
.timeline-item h5 { font-size: 15px; color: var(--primary); }
.timeline-item p { font-size: 13px; color: var(--text-light); }

/* ===== News ===== */
.news-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; }
.news-card {
  background: var(--white);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
  transition: all .3s;
  border: 1px solid #f0f0f5;
}
.news-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); }
.news-img {
  height: 180px;
  background: var(--gradient-hero);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,.2);
  font-size: 48px;
}
.news-body { padding: 20px; }
.news-body .date { font-size: 12px; color: var(--accent); font-weight: 600; }
.news-body h4 { font-size: 16px; color: var(--primary); margin: 8px 0; line-height: 1.4; }
.news-body p { font-size: 13px; color: var(--text-light); line-height: 1.7; }

/* ===== Download ===== */
.download-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
.download-card {
  background: var(--white);
  border-radius: var(--radius);
  padding: 24px;
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  gap: 16px;
  transition: all .3s;
  border: 1px solid #f0f0f5;
}
.download-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); }
.download-icon {
  width: 50px;
  height: 50px;
  background: rgba(201,168,76,.1);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
}
.download-info { flex: 1; min-width: 0; }
.download-info h4 { font-size: 14px; color: var(--primary); margin-bottom: 4px; }
.download-info span { font-size: 12px; color: var(--text-light); }
.download-btn {
  padding: 8px 18px;
  background: var(--primary);
  color: var(--white);
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  white-space: nowrap;
  transition: all .3s;
}
.download-btn:hover { background: var(--primary-light); }

/* ===== Contact ===== */
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; }
.contact-info h4 { font-size: 20px; color: var(--primary); margin-bottom: 20px; }
.contact-item {
  display: flex;
  gap: 14px;
  margin-bottom: 18px;
  align-items: flex-start;
}
.contact-item .ci-icon {
  width: 40px;
  height: 40px;
  background: rgba(201,168,76,.1);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
}
.contact-item .ci-text { font-size: 14px; color: var(--text-dark); }
.contact-item .ci-label { font-size: 12px; color: var(--text-light); }
.contact-form { background: var(--white); padding: 30px; border-radius: var(--radius); box-shadow: var(--shadow); }
.contact-form h4 { font-size: 18px; color: var(--primary); margin-bottom: 20px; }
.form-group { margin-bottom: 16px; }
.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid #e0e0e5;
  border-radius: 8px;
  font-size: 14px;
  transition: all .3s;
  font-family: inherit;
}
.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(201,168,76,.15);
}
.form-group textarea { resize: vertical; min-height: 100px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

/* ===== Map Section ===== */
.map-section { padding: 0; }
.map-placeholder {
  height: 350px;
  background: var(--bg-light);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-light);
  font-size: 14px;
  gap: 8px;
}

/* ===== Footer ===== */
.footer {
  background: var(--primary);
  color: rgba(255,255,255,.7);
  padding: 50px 0 30px;
}
.footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 30px; }
.footer-brand .logo-icon { margin-bottom: 12px; }
.footer-brand p { font-size: 13px; line-height: 1.8; }
.footer h4 { color: var(--white); font-size: 15px; margin-bottom: 16px; }
.footer ul li { margin-bottom: 8px; }
.footer ul a { font-size: 13px; transition: color .3s; }
.footer ul a:hover { color: var(--accent); }
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,.08);
  padding-top: 20px;
  text-align: center;
  font-size: 13px;
}

/* ===== Mobile Nav ===== */
@media (max-width: 968px) {
  .nav { display: none; }
  .nav.open { display: flex; flex-direction: column; position: absolute; top: 70px; left: 0; right: 0;
    background: var(--white); box-shadow: 0 10px 30px rgba(0,0,0,.1); padding: 20px; gap: 0; border-top: 1px solid #eee; }
  .nav > li > a { padding: 12px 16px; }
  .nav .dropdown { position: static; box-shadow: none; opacity: 1; visibility: visible;
    transform: none; padding-left: 20px; display: none; }
  .nav > li.open .dropdown { display: block; }
  .menu-toggle { display: block; }
  .hero .container { grid-template-columns: 1fr; gap: 30px; }
  .hero { min-height: auto; }
  .hero-content { padding: 40px 0 0; }
  .about-grid { grid-template-columns: 1fr; }
  .contact-grid { grid-template-columns: 1fr; }
  .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .footer-grid { grid-template-columns: 1fr 1fr; gap: 30px; }
  .org-list { grid-template-columns: 1fr; }
  .top-bar-links { display: none; }
}

@media (max-width: 480px) {
  .hero-info-grid { grid-template-columns: 1fr; }
  .schedule-tabs { flex-wrap: wrap; }
  .form-row { grid-template-columns: 1fr; }
  .footer-grid { grid-template-columns: 1fr; }
  .section { padding: 50px 0; }
  .hero-card { padding: 24px 16px; }
  .countdown-grid { gap: 8px; }
  .countdown-item .num { font-size: 24px; }
}
